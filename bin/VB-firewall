#!/bin/bash
###############################################################################
# VB-firewall - Sync ViciWhite IP list from DB to firewalld ipset
#
# Usage:
#   VB-firewall --white --dynamic [--quiet]
#
# Reads IPs from vicidial_ip_list_entries (list_id=ViciWhite),
# syncs them into the 'dynamiclist' ipset managed by firewalld.
# Removes IPs from ipset that are no longer in DB.
###############################################################################

CONF="/etc/astguiclient.conf"
IPSET_NAME="dynamiclist"
IP_LIST_ID="ViciWhite"
QUIET=0
CHANGED=0

# Parse flags
WHITE=0
DYNAMIC=0
for arg in "$@"; do
    case "$arg" in
        --white)   WHITE=1 ;;
        --dynamic) DYNAMIC=1 ;;
        --quiet)   QUIET=1 ;;
        --help|-h)
            echo "Usage: VB-firewall --white --dynamic [--quiet]"
            echo "Syncs ViciWhite DB entries to dynamiclist ipset"
            exit 0
            ;;
    esac
done

if [[ $WHITE -ne 1 || $DYNAMIC -ne 1 ]]; then
    echo "Usage: VB-firewall --white --dynamic [--quiet]"
    exit 1
fi

log() {
    [[ $QUIET -eq 1 ]] && return
    echo "$(date '+%Y-%m-%d %H:%M:%S') VB-firewall: $*"
}

# Read DB credentials from astguiclient.conf
get_conf() {
    grep "^${1} " "$CONF" 2>/dev/null | sed "s/^${1} => //"
}

DB_HOST=$(get_conf VARDB_server)
DB_NAME=$(get_conf VARDB_database)
DB_USER=$(get_conf VARDB_user)
DB_PASS=$(get_conf VARDB_pass)
DB_PORT=$(get_conf VARDB_port)

if [[ -z "$DB_HOST" || -z "$DB_USER" || -z "$DB_PASS" ]]; then
    echo "ERROR: Cannot read DB credentials from $CONF" >&2
    exit 1
fi

# Ensure the ipset exists in firewalld (create at runtime if needed)
if ! firewall-cmd --get-ipsets 2>/dev/null | grep -qw "$IPSET_NAME"; then
    log "Creating ipset $IPSET_NAME in firewalld"
    firewall-cmd --permanent --new-ipset="$IPSET_NAME" --type=hash:ip 2>/dev/null || true
    firewall-cmd --reload 2>/dev/null
fi

# Get IPs from database
DB_IPS=$(mysql -h "$DB_HOST" -P "$DB_PORT" -u "$DB_USER" -p"$DB_PASS" "$DB_NAME" \
    -N -B -e "SELECT ip_address FROM vicidial_ip_list_entries WHERE ip_list_id='${IP_LIST_ID}';" 2>/dev/null | sort -u)
# Get current IPs in ipset
CURRENT_IPS=$(firewall-cmd --ipset="$IPSET_NAME" --get-entries 2>/dev/null | sort -u)

# Add IPs that are in DB but not in ipset
while IFS= read -r ip; do
    [[ -z "$ip" ]] && continue
    if ! echo "$CURRENT_IPS" | grep -qxF "$ip"; then
        log "Adding $ip to $IPSET_NAME"
        firewall-cmd --ipset="$IPSET_NAME" --add-entry="$ip" 2>/dev/null
        CHANGED=1
    fi
done <<< "$DB_IPS"

# Remove IPs that are in ipset but not in DB
while IFS= read -r ip; do
    [[ -z "$ip" ]] && continue
    if ! echo "$DB_IPS" | grep -qxF "$ip"; then
        log "Removing $ip from $IPSET_NAME"
        firewall-cmd --ipset="$IPSET_NAME" --remove-entry="$ip" 2>/dev/null
        CHANGED=1
    fi
done <<< "$CURRENT_IPS"

# Only persist to disk when changes were made
if [[ $CHANGED -eq 1 ]]; then
    firewall-cmd --runtime-to-permanent 2>/dev/null
    log "Changes saved to permanent config"
fi

log "Sync complete. IPs in $IPSET_NAME: $(firewall-cmd --ipset="$IPSET_NAME" --get-entries 2>/dev/null | wc -w)"

# Replicate ViciWhite IPs to a public VPS's SIP allowlist (inet sip-allowlist /
# allowed_sip). OPTIONAL — only relevant for a ViciDial server that sits behind
# CGNAT and relays SIP through a public VPS (see SIP-ALLOWLIST.md). Without it,
# on such a setup, brute-force attackers reach Asterisk through the VPS DNAT
# because the VPS's SNAT masks every public source as one IP, so the local
# ipset above can't distinguish agents from attackers.
#
# Most vicidial-dynportal installs do NOT need this and can ignore it: the
# push only runs if /etc/vicidial-dynportal-vps-relay.conf exists and sets
# VPS_HOST (see that file's header comment for an example).
# Best-effort: SSH or VPS unreachable must not break the local sync.
VPS_RELAY_CONF="/etc/vicidial-dynportal-vps-relay.conf"
[[ -f "$VPS_RELAY_CONF" ]] && source "$VPS_RELAY_CONF"
push_to_vps() {
    local ips="$1"
    local elements
    # Filter to IPv4 dotted-quad only — VPS DNAT and the allowlist set are IPv4.
    elements=$(printf '%s\n' "$ips" \
        | grep -E '^([0-9]{1,3}\.){3}[0-9]{1,3}$' \
        | awk '{printf "%s timeout 24h, ", $1}' | sed 's/, $//')
    if [[ -z "$elements" ]]; then
        # No agents: clear the dynamic set so a freshly-deauthorized agent
        # is rejected on next REGISTER instead of waiting for timeout.
        ssh -p "$VPS_PORT" -o ConnectTimeout=5 -o BatchMode=yes \
            root@"$VPS_HOST" "nft flush set inet sip-allowlist allowed_sip" \
            >/dev/null 2>&1 || log "VPS push: ssh/flush failed (non-fatal)"
        return
    fi
    ssh -p "$VPS_PORT" -o ConnectTimeout=5 -o BatchMode=yes \
        root@"$VPS_HOST" "nft -f -" >/dev/null 2>&1 <<EOF || log "VPS push: ssh/nft failed (non-fatal)"
flush set inet sip-allowlist allowed_sip
add element inet sip-allowlist allowed_sip { $elements }
EOF
}
[[ -n "$VPS_HOST" ]] && push_to_vps "$DB_IPS"
